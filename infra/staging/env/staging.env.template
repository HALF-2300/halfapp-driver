# Copy to staging.env.local and fill in secrets (never commit staging.env.local).
# On the VPS, provision links this file to /etc/halfapp/staging.env
#
# Orchestration: docs/HALFAPP_STAGING_CLOSURE_ORCHESTRATION_01.md

# --- [HUMAN GATE] GATE-VPS-1 (~15 min) — operator SSH (laptop only) ---
# STAGING_HOST=203.0.113.10
# STAGING_USER=halfapp
# STAGING_SSH_KEY=~/.ssh/id_ed25519

# --- [HUMAN GATE] GATE-NEON-1 (~10 min) — Neon project halfapp-staging ---
# Sign up at https://neon.tech → paste pooled/direct URL below
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ≥32 random bytes; production guard enforced when HALFAPP_ENV=production
SECRET_KEY=

# App reads CORS_ORIGINS (deploy brief: ALLOWED_ORIGINS)
CORS_ORIGINS=https://staging.halfapp.app,https://rider-stub.halfapp.app

HALFAPP_ENV=production
HALFAPP_OPEN_BOARD_DISPATCH=1
HALFAPP_DOSSIER_SPINE_ENABLED=0
ROUTING_FALLBACK_ENABLED=1
OSRM_BASE_URL=http://osrm-routed:5000
PAYMENTS_ENABLED=0
PAYOUTS_ENABLED=0
ENGINEERING_ASSISTANT_ENABLED=0
LOG_LEVEL=info

# --- [HUMAN GATE] GATE-DNS-1 (optional) — point staging.halfapp.app A-record at VPS ---

# Optional: absolute path to prepared OSRM files on the VPS host
# OSRM_DATA_DIR=/opt/halfapp-driver/docker/osrm-portland/data

# --- [HUMAN GATE] GATE-STADIA-1 (optional) — driver-app map tiles; default CARTO needs no key ---
# VITE_STADIA_API_KEY=

# Optional: override env file path for docker compose on laptop
# HALFAPP_STAGING_ENV_FILE=infra/staging/env/staging.env.local
