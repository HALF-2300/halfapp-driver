# HalfApp staging — VPS runtime secrets (/etc/halfapp/staging.env on the server).
# Copy to the VPS before running 01_provision_vps.sh:
#   scp infra/staging/staging.env.local root@HOST:/etc/halfapp/staging.env
# Do not commit filled copies.

STAGING_DOMAIN=staging.example.com
CERTBOT_EMAIL=ops@halfapp.app

# PostgreSQL (Agent 3 — alembic upgrade head)
DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:5432/halfapp

# Optional — passed to backend container / deploy scripts
# JWT_SECRET=
# CORS_ORIGINS=https://staging.example.com
