# Copy to /etc/halfapp/staging.env on the VPS (chmod 600).
# Used by: docker compose -f infra/staging/docker/docker-compose.yml --env-file /etc/halfapp/staging.env

HALFAPP_ENV=production
SECRET_KEY=replace_with_secrets_token_urlsafe_32_or_longer
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/halfapp?sslmode=require

# Driver app origin(s) served in front of this API (comma-separated).
CORS_ORIGINS=https://staging.example.com

ROUTING_PROVIDER=osrm_self_hosted
ROUTING_FALLBACK_ENABLED=true
MAP_DISPLAY_PROVIDER=current_osm_leaflet

# OSRM is set in compose (http://osrm-routed:5000); do not point at localhost here.
# OSRM_BASE_URL=http://osrm-routed:5000

PAYMENTS_ENABLED=0
PAYOUTS_ENABLED=0
# HALFAPP_ENABLE_RIDE_SIMULATION must stay unset in production.
