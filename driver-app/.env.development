# Driver-only MVP — default dev experience must work without a backend.
# This enables the offline mock fallback for auth/profile/rides API calls
# so `npm run dev` produces a usable demo loop end-to-end.
# Playwright trust lane sets this back to "false" explicitly.
VITE_ALLOW_OFFLINE_MOCK=true
VITE_ENABLE_RIDE_SIMULATION=true
VITE_MAP_DISPLAY_PROVIDER=carto_voyager
VITE_ROUTING_PROVIDER=current_or_osrm
VITE_TRAFFIC_PROVIDER=none
VITE_GOOGLE_MAPS_FALLBACK_ENABLED=false
VITE_MAPBOX_TRAFFIC_ENABLED=false
