# Copy to .env and adjust.
# P0 default dev DB (from repo root: docker compose up -d postgres):
DATABASE_URL=postgresql+psycopg2://halfapp:halfapp@localhost:5432/halfapp
# SQLite fallback (no Docker):
# DATABASE_URL=sqlite:///./halfapp_local.db
# HALFAPP_ENV=development  # development | test | production (see docs/DEPLOY_ENV_VARS.md)
SECRET_KEY=change_me_in_production
# HALFAPP_ENABLE_RIDE_SIMULATION=1  # required for POST /drivers/simulate-ride (off by default)
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh tokens (HALFAPP_AUTH_REFRESH_REVOCATION_01)
# ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_BYTES=32
AUTH_REFRESH_ENABLED=1
# Payments / Stripe Connect (HALFAPP_PAYMENTS_EXECUTION_01/02)
PAYMENTS_ENABLED=0
# Ingest Connect transfers/payouts + driver payout visibility (Phase 5)
PAYOUTS_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional second secret for Connect-scoped webhook endpoints
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_RETURN_URL=http://127.0.0.1:3022/driver/stripe/return
STRIPE_CONNECT_REFRESH_URL=http://127.0.0.1:3022/driver/stripe/refresh
PLATFORM_FEE_BPS=800
CURRENCY=usd
# Comma-separated origins; dev mode also unions localhost:5173, :3000, :3022
CORS_ORIGINS=http://127.0.0.1:3022,http://localhost:3022,http://127.0.0.1:3023,http://localhost:3023,http://127.0.0.1:3024,http://localhost:3024
# Map / routing v0.1 (free stack default)
MAP_DISPLAY_PROVIDER=current_osm_leaflet
ROUTING_PROVIDER=osrm_self_hosted
OSRM_BASE_URL=http://127.0.0.1:5000
ROUTING_FALLBACK_ENABLED=true
TRAFFIC_PROVIDER=none
TRAFFIC_SIGNALS_ENABLED=false
# Optional free official feeds (register at TripCheck / WSDOT traveler API portals)
ODOT_TRIPCHECK_SUBSCRIPTION_KEY=
WSDOT_ACCESS_CODE=
# Open-board dispatch (default in tests). Set HALFAPP_AUTO_ASSIGN=1 for Phase 2 auto-matching.
HALFAPP_OPEN_BOARD_DISPATCH=1
HALFAPP_AUTO_ASSIGN=0
GOOGLE_MAPS_FALLBACK_ENABLED=false
MAPBOX_TRAFFIC_ENABLED=false
# SIL/CRL background workers (off in dev/tests — enable in staging/prod API process)
# HALFAPP_SIL_CRL_WORKER_ENABLED=1
# Fleet GPS telemetry retention (days); daily cleanup via cron or manual job
HALFAPP_TELEMETRY_RETENTION_DAYS=14
# Engineering assistant (backend-only — disabled by default; never expose to driver-app)
# ENGINEERING_ASSISTANT_ENABLED=0
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
